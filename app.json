{
  "expo": {
    "name": "Match_F",
    "slug": "Match_F",
    "version": "1.0.0",
    "orientation": "portrait",

    "scheme": "matchf",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#134F19"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Match_F"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/splash-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true,
            "largeHeap": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#134F19",
          "dark": {
            "backgroundColor": "#134F19"
          },
          "hideAsync": false
        }
      ],
      "expo-asset",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6905b32c-0252-4e75-8611-89a8026fd8a7"
      }
    },
    "owner": "bigsteppa"
  }
}
